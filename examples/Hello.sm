CALL ("string", 1, false)
CALL ("printf", 2, false)
DROP
STRING ("These structures can be nested and heterogeneous: %s\\n")
CONST (1)
STRING ("2")
CALL (".array", 2, false)
SEXP ("Apple", 0)
LINE (11)
CLOSURE ("lambda_1", [])
CONST (0)
SEXP ("cons", 2)
SEXP ("cons", 2)
SEXP ("cons", 2)
CALL ("string", 1, false)
CALL ("printf", 2, false)
DROP
STRING ("That's all for now, bye!\\n")
CALL ("printf", 1, false)
SLABEL ("2")
END
LABEL ("lambda_1")
BEGIN ("lambda_1", 1, 0, [], ["x"], [{ blab="70"; elab="71"; names=[]; subs=[{ blab="73"; elab="74"; names=[]; subs=[]; }]; }])
SLABEL ("70")
SLABEL ("73")
CONST (3)
SEXP ("Melon", 1)
SLABEL ("74")
LABEL ("72")
SLABEL ("71")
END
LABEL ("lambda_0")
BEGIN ("lambda_0", 2, 0, [], ["x"; "y"], [{ blab="76"; elab="77"; names=[]; subs=[{ blab="79"; elab="80"; names=[]; subs=[]; }]; }])
SLABEL ("76")
SLABEL ("79")
LINE (10)
LD (Arg (0))
LD (Arg (1))
BINOP ("+")
SLABEL ("80")
LABEL ("78")
SLABEL ("77")
END
