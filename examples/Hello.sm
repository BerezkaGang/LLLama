DROP
STRING ("I can construct values of various shapes,\\n")
CALL ("printf", 1, false)
DROP
LINE (2)
STRING ("convert them into strings and print. Here you are:\\n")
CALL ("printf", 1, false)
DROP
LINE (3)
STRING ("Regular integers: %d or even %s\\n")
CONST (3)
CONST (4611686018427387903)
CALL ("string", 1, false)
CALL ("printf", 3, false)
DROP
LINE (5)
STRING ("Regular integers: %d or even %s\\n")
CONST (3)
CONST (2305843009213693951)
CALL ("string", 1, false)
CALL ("printf", 3, false)
DROP
LINE (6)
